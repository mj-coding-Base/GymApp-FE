# Dependencies (critical - must exclude)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
# NOTE: package-lock.json is NEEDED for npm ci - do NOT exclude it!

# Build artifacts (critical - must exclude)
.next/
out/
dist/
build/
.turbo/

# Environment files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Git and GitHub
.git/
.gitignore
.github/

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# Testing
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation (not needed in build)
*.md
!README.md
docs/

# Large files that slow down builds
*.tar.gz
*.zip
*.log
*.map

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Misc
*.pem
LICENSE
CHANGELOG.md
